    if (frac > 0.05 && full < 8) html += '<span class="p" style="animation-delay:' + (full*50) + 'ms"><span class="ghost">' + PERSON + '</span><span class="fill" style="--w:' + Math.round(frac*100) + '%">' + PERSON + '</span></span>';
    box.innerHTML = html;
  }
  var fmt = function(n){ return '$' + Math.round(n).toLocaleString('en-US'); };
  function usSalary(){
    if (role === 'swe') return coast.swe * SWE_SCALE[level];
    if (role === 'gtm') return GTM_US[level];
    return SDR_US[level];
  }
  function vayraYear(){ var r = RATES[role][level]; return r.h ? r.h * HOURS * 12 : r.m * 12; }
  function vayraLabel(){ var r = RATES[role][level]; return r.h ? 'Vayra, from $' + r.h + ' an hour' : 'Vayra, from ' + fmt(r.m) + ' a month'; }
  function quoteHref(){
    var who = count + ' ' + ROLE_NAMES[role] + (count > 1 ? 's' : '') + ', ' + LEVELS[level].toLowerCase() + ' level';
    var body = 'Hi Vayra,\n\nWe are looking for: ' + who + '\nOur team is in: ' + coast.city + ' (' + coast.region + ')\nIdeal start date: \n\nThanks,\n';
    return 'mailto:hello@vayra.team?subject=' + encodeURIComponent('Quote: ' + who) + '&body=' + encodeURIComponent(body);
  }
  function renderCalc(){
    var div = per === 'month' ? 12 : 1;
    var usOne = usSalary() / (1 - BENEFITS), laOne = vayraYear();
    var us = usOne * count / div, la = laOne * count / div, ratio = usOne / laOne;
    $('t-us').textContent = role === 'swe' ? 'US hire in ' + coast.city + ', salary plus benefits' : 'US hire, national average, salary plus benefits';
    $('t-la').textContent = vayraLabel();
    tween('v-us', us); tween('v-la', la); tween('v-gap', Math.max(0, us - la));
    $('gap-l').textContent = 'You save up to, ' + (per === 'month' ? 'per month' : 'per year');
    var lvl = LEVELS[level].toLowerCase();
    $('eq-text').innerHTML = 'One US ' + lvl + ' ' + ROLE_NAMES[role] + (role === 'swe' ? ' in ' + coast.city : '') + ' costs as much as <b>' + (Math.round(ratio*10)/10) + '</b> Vayra ' + lvl + (lvl === 'manager' ? 's' : ' pros') + '.';
    people(ratio);
    var rg = $('cnt-range'); rg.value = count; rg.style.setProperty('--p', ((count - 1) / 19 * 100) + '%');
    document.querySelectorAll('[data-per]').forEach(function(el){ el.setAttribute('aria-pressed', el.getAttribute('data-per') === per ? 'true' : 'false'); });
    $('b-us').style.width = '100%'; $('b-la').style.width = Math.min(100, la/us*100).toFixed(1) + '%';
    $('cnt').textContent = count; $('cnt-label').textContent = count === 1 ? 'person' : 'people';
    $('fine').textContent = NOTES[role] + ' Benefits add 30% of compensation costs in private industry (BLS, June 2026). Vayra uses starting rates for a full-time month of ' + HOURS + ' hours, so your quote can be higher for niche skills.';
    document.querySelectorAll('[data-role]').forEach(function(el){ el.setAttribute('aria-pressed', el.getAttribute('data-role') === role ? 'true' : 'false'); });
    document.querySelectorAll('[data-level]').forEach(function(el){ el.setAttribute('aria-pressed', el.getAttribute('data-level') === level ? 'true' : 'false'); });
    var href = quoteHref(); $('quote-btn').setAttribute('href', href); var xq = $('exit-quote'); if (xq) xq.setAttribute('href', href);
    var xs = $('exit-sum'); if (xs) xs.textContent = count + ' ' + ROLE_NAMES[role] + (count > 1 ? 's' : '') + ', ' + LEVELS[level].toLowerCase() + ' level, for a team in ' + coast.city + '.';
  }
  calcReady = true;
  document.querySelectorAll('[data-role]').forEach(function(el){ el.addEventListener('click', function(){ role = el.getAttribute('data-role'); renderCalc(); }); });
  document.querySelectorAll('[data-level]').forEach(function(el){ el.addEventListener('click', function(){ level = el.getAttribute('data-level'); renderCalc(); }); });
  document.querySelectorAll('[data-per]').forEach(function(el){ el.addEventListener('click', function(){ per = el.getAttribute('data-per'); renderCalc(); }); });
  $('cnt-range').addEventListener('input', function(e){ count = parseInt(e.target.value, 10) || 1; renderCalc(); });

  // ---- exit intent: one clear ask before someone leaves
  var exitEl = $('exit'), shown = false, lastFocus = null;
  function seen(){ try { return sessionStorage.getItem('vayra-exit') === '1'; } catch(e){ return shown; } }
  function mark(){ shown = true; try { sessionStorage.setItem('vayra-exit','1'); } catch(e){} }
  function openExit(){
    if (shown || seen() || !exitEl) return;
    mark(); lastFocus = document.activeElement; exitEl.hidden = false;
    setTimeout(function(){ $('exit-quote').focus(); }, 30);
  }
  function closeExit(){ exitEl.hidden = true; if (lastFocus && lastFocus.focus) lastFocus.focus(); }
  document.addEventListener('mouseout', function(e){ if (!e.relatedTarget && e.clientY <= 0) openExit(); });
  var maxDepth = 0, lastY = window.scrollY, lastT = Date.now();
  window.addEventListener('scroll', function(){
    var y = window.scrollY, t = Date.now(), h = document.documentElement.scrollHeight - innerHeight;
    if (h > 0) maxDepth = Math.max(maxDepth, y / h);
    if (window.matchMedia('(pointer: coarse)').matches && maxDepth > 0.45 && (lastY - y) > 140 && (t - lastT) < 260) openExit();
    lastY = y; lastT = t;
  }, {passive:true});
  if (exitEl) {
    exitEl.addEventListener('click', function(e){ if (e.target === exitEl) closeExit(); });
    $('exit-close').addEventListener('click', closeExit);
    $('exit-later').addEventListener('click', closeExit);
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && !exitEl.hidden) closeExit(); });
    $('exit-copy').addEventListener('click', function(){
      var out = $('exit-copied');
      if (navigator.clipboard && navigator.clipboard.writeText) {
        navigator.clipboard.writeText('hello@vayra.team').then(function(){ out.textContent = 'Copied hello@vayra.team'; }).catch(function(){ out.textContent = 'Select hello@vayra.team and copy it.'; });
      } else { out.textContent = 'Select hello@vayra.team and copy it.'; }
    });
    $('quote-btn').addEventListener('click', mark);
  }
  renderCalc();
})();
</script>

