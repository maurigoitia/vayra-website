    var s0 = ((start % 24) + 24) % 24, e0 = s0 + (end - start);
    if (e0 <= 24) parts.push([s0, e0]); else { parts.push([s0, 24]); parts.push([0, e0 - 24]); }
    el.style.left = (parts[0][0]/24*100) + '%'; el.style.width = ((parts[0][1]-parts[0][0])/24*100) + '%';
  }
  function renderTime(){
    var c = CITIES[cityIdx];
    var uh = hourIn(coast.tz), th = hourIn(c.tz);
    $('say').innerHTML = 'It’s ' + timeIn(coast.tz) + ' in ' + coast.city + ' and you’re <b>' + activity(uh) + '</b>. In ' + c.name + ' it’s ' + timeIn(c.tz) + ' and your team is <b>' + activity(th, c.cc) + '</b>.';
    var d = (offsetMin(c.tz) - offsetMin(coast.tz)) / 60;   // team is d hours ahead
    var ts = 9 - d, te = 18 - d;                              // team workday in your local hours
    var shared = Math.max(0, Math.min(18, te) - Math.max(9, ts));
    band($('band-you'), 9, 18); band($('band-team'), ts, te);
    $('strip-you').textContent = coast.city; $('strip-team').textContent = c.name;
    var hrs = (Math.round(shared*10)/10) + (shared === 1 ? ' shared work hour' : ' shared work hours');
    $('shared').textContent = hrs + (d === 0 ? ', same clock' : ', ' + Math.abs(d) + (Math.abs(d) === 1 ? ' hour ' : ' hours ') + (d > 0 ? 'ahead of you' : 'behind you'));
    var th2 = $('t-hours'); if (th2) { th2.textContent = (Math.round(shared*10)/10) + (shared === 1 ? ' hour' : ' hours'); $('t-line').textContent = 'of shared work hours between ' + coast.city + ' and ' + c.name + '. Questions get answered today, not tomorrow.'; }
    $('ch-meta').textContent = c.coord + ', ' + utcLabel(c.tz) + ', ' + timeIn(c.tz) + ' there now';
  }

  document.querySelectorAll('[data-city]').forEach(function(el){
    el.addEventListener('click', function(){
      var id = el.getAttribute('data-city'), i = CITIES.findIndex(function(c){ return c.id === id; });
      if (i >= 0) { cityIdx = i; renderCity(); }
    });
    if (el.classList.contains('at-pin')) {
      el.addEventListener('mouseenter', function(){ var c = CITIES.filter(function(x){ return x.id === el.getAttribute('data-city'); })[0]; var lab = $('at-label'); lab.textContent = c.name; lab.style.setProperty('--x', c.x + '%'); lab.style.setProperty('--y', c.y + '%'); lab.classList.toggle('left', c.x > 62); });
      el.addEventListener('mouseleave', function(){ var c = CITIES[cityIdx], lab = $('at-label'); lab.textContent = c.name; lab.style.setProperty('--x', c.x + '%'); lab.style.setProperty('--y', c.y + '%'); lab.classList.toggle('left', c.x > 62); });
    }
  });
  document.querySelectorAll('[data-usselect]').forEach(function(el){
    el.addEventListener('change', function(){ var id = el.value; COASTS.forEach(function(c){ if (c.id === id) coast = c; }); geoNote = ''; renderCoast(); });
  });
  // closer than a time zone: ask a location service for the visitor's city, then use the nearest tech hub
  function nearest(lat, lon){
    var best = null, bd = 1e9;
    COASTS.forEach(function(c){ var dl = (c.lat - lat), dn = (c.lon - lon) * Math.cos(lat * Math.PI / 180), d = dl*dl + dn*dn; if (d < bd) { bd = d; best = c; } });
    return best;
  }
  try {
    if (window.fetch && window.AbortController) {
      var ac = new AbortController(); setTimeout(function(){ ac.abort(); }, 2500);
      fetch('https://ipapi.co/json/', {signal: ac.signal}).then(function(r){ return r.ok ? r.json() : null; }).then(function(g){
        if (!g || g.country_code !== 'US' || typeof g.latitude !== 'number') return;
        var n = nearest(g.latitude, g.longitude); if (!n) return;
        coast = n; geoNote = g.city && g.city !== n.city ? 'Nearest tech hub to ' + g.city + '. Change it anytime.' : 'Based on your location. Change it anytime.';
        renderCoast();
      }).catch(function(){});
    }
  } catch(e) {}

  renderCoast(); renderCity();
  setInterval(renderTime, 30000);

  // ---- exit intent: one clear ask before someone leaves
  var exitEl = $('exit'), shown = false, lastFocus = null;
  function seen(){ try { return sessionStorage.getItem('vayra-exit') === '1'; } catch(e){ return shown; } }
  function mark(){ shown = true; try { sessionStorage.setItem('vayra-exit','1'); } catch(e){} }
  function openExit(){
    if (shown || seen() || !exitEl) return;
    mark(); lastFocus = document.activeElement; exitEl.hidden = false;
    setTimeout(function(){
      var eq = $('exit-quote') || $('exit-close');
      if (eq && typeof eq.focus === 'function') eq.focus();
    }, 30);
  }
  function closeExit(){ exitEl.hidden = true; if (lastFocus && lastFocus.focus) lastFocus.focus(); }
  document.addEventListener('mouseout', function(e){ if (!e.relatedTarget && e.clientY <= 0) openExit(); });
  var maxDepth = 0, lastY = window.scrollY, lastT = Date.now();
  window.addEventListener('scroll', function(){
    var y = window.scrollY, t = Date.now(), h = document.documentElement.scrollHeight - innerHeight;
    if (h > 0) maxDepth = Math.max(maxDepth, y / h);
    if (window.matchMedia('(pointer: coarse)').matches && maxDepth > 0.45 && (lastY - y) > 140 && (t - lastT) < 260) openExit();
    lastY = y; lastT = t;
  }, {passive:true});
  if (exitEl) {
    exitEl.addEventListener('click', function(e){ if (e.target === exitEl) closeExit(); });
    var exitClose = $('exit-close');
    if (exitClose) exitClose.addEventListener('click', closeExit);
    var exitLater = $('exit-later');
    if (exitLater) exitLater.addEventListener('click', closeExit);
    document.addEventListener('keydown', function(e){ if (e.key === 'Escape' && !exitEl.hidden) closeExit(); });
    var exitCopy = $('exit-copy');
    if (exitCopy) {
      exitCopy.addEventListener('click', function(){
        var out = $('exit-copied');
        if (navigator.clipboard && navigator.clipboard.writeText) {
          navigator.clipboard.writeText('hello@vayra.team').then(function(){
            if (out) out.textContent = 'Copied hello@vayra.team';
          }).catch(function(){
            if (out) out.textContent = 'Select hello@vayra.team and copy it.';
          });
        } else if (out) {
          out.textContent = 'Select hello@vayra.team and copy it.';
        }
      });
    }
    var quoteBtn = $('quote-btn');
    if (quoteBtn) quoteBtn.addEventListener('click', mark);
  }
  if (typeof renderCalc === 'function') {
    renderCalc();
  }
})();
</script>

