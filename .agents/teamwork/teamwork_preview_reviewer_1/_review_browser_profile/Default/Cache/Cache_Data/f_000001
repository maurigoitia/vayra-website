<style>
body{margin:0}img{max-width:100%}[hidden]{display:none!important}
/* Layout: night-shift navy site (Rubicon feel) that opens onto a warm cafe wall of city posters (Howdy warmth). Single committed dark look. */
:root{
  color-scheme: dark;
  --ink:#0A0F1F;        /* page background, deep navy */
  --ink-2:#111934;      /* raised surfaces */
  --ink-3:#1A2447;      /* hover / lines strong */
  --line:#24305A;       /* hairlines */
  --fg:#EEF1FA;         /* main text */
  --muted:#A5AECB;      /* secondary text */
  --sun:#FFB547;        /* accent: Andes sun */
  --sun-ink:#1B1204;    /* text on accent */
  --sky:#8CC8EE;        /* secondary accent: celeste */
  --leaf:#7ED3A6;       /* agent / ok state */
  --paper:#EADFCB;      /* cafe wall */
  --paper-ink:#2A2118;  /* text on wall */
  --paper-muted:#6B5D4C;
  --f-display:"Bricolage Grotesque", "Hanken Grotesk", system-ui, sans-serif;
  --f-body:"Hanken Grotesk", system-ui, -apple-system, "Segoe UI", sans-serif;
  --f-mono:"JetBrains Mono", ui-monospace, "SFMono-Regular", Menlo, monospace;
  --f-poster:"Anton", "Oswald", "Arial Narrow", Impact, sans-serif;
  --r:14px;
}
*{box-sizing:border-box}
html{scroll-behavior:smooth}
body{background:var(--ink);color:var(--fg);font-family:var(--f-body);font-size:17px;line-height:1.6;-webkit-font-smoothing:antialiased;overflow-x:hidden}
a{color:inherit}
:focus-visible{outline:2px solid var(--sun);outline-offset:3px;border-radius:6px}
h1,h2,h3{font-family:var(--f-display);line-height:1.05;letter-spacing:-.02em;margin:0;text-wrap:balance}
p{margin:0}
.wrap{max-width:1180px;margin-inline:auto;padding-left:max(20px, env(safe-area-inset-left,0px));padding-right:max(20px, env(safe-area-inset-right,0px))}
.eyebrow{font-family:var(--f-mono);font-size:12.5px;letter-spacing:.14em;text-transform:uppercase;color:var(--sun)}
.lede{color:var(--muted);font-size:19px;max-width:58ch}

/* buttons */
.btn{display:inline-flex;align-items:center;gap:10px;font:600 16px/1 var(--f-body);text-decoration:none;padding:15px 22px;border-radius:999px;border:1px solid transparent;transition:transform .2s ease, background .2s ease, border-color .2s ease}
.btn-sun{background:var(--sun);color:var(--sun-ink)}
.btn-sun:hover{transform:translateY(-2px)}
.btn-ghost{border-color:var(--line);color:var(--fg)}
.btn-ghost:hover{border-color:var(--muted)}
.btn .arr{font-family:var(--f-mono)}

/* nav */
.nav{position:sticky;top:env(safe-area-inset-top,0px);z-index:20;background:color-mix(in srgb, var(--ink) 86%, transparent);backdrop-filter:blur(10px);border-bottom:1px solid var(--line)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;gap:20px;padding-block:14px}
.brand{display:flex;align-items:center;gap:10px;text-decoration:none;font:800 22px/1 var(--f-display);letter-spacing:-.02em}
.brand svg{width:30px;height:30px}
.nav ul{display:flex;gap:26px;list-style:none;margin:0;padding:0}
.nav ul a{text-decoration:none;color:var(--muted);font-size:15px}
.nav ul a:hover{color:var(--fg)}
.nav .btn{padding:11px 18px;font-size:15px}

/* hero */
.hero{position:relative;overflow:hidden;border-bottom:1px solid var(--line)}
.hero::before{content:"";position:absolute;inset:0;background:
  radial-gradient(60% 70% at 85% 10%, color-mix(in srgb, var(--sun) 18%, transparent), transparent 70%),
  linear-gradient(var(--line) 1px, transparent 1px) 0 0/56px 56px,
  linear-gradient(90deg, var(--line) 1px, transparent 1px) 0 0/56px 56px;
  opacity:.55;mask-image:linear-gradient(to bottom, #000 40%, transparent)}
.hero .wrap{position:relative;display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;padding-block:88px 96px}
.hero h1{font-size:clamp(40px,6.2vw,76px);font-weight:800;margin-block:18px 22px}
.hero h1 em{font-style:normal;color:var(--sun)}
.hero .cta{display:flex;flex-wrap:wrap;gap:12px;margin-top:32px}
.route{display:inline-flex;align-items:center;gap:10px;font-family:var(--f-mono);font-size:13px;letter-spacing:.12em;color:var(--fg);border:1px solid var(--line);background:var(--ink-2);padding:7px 12px;border-radius:999px}
.route i{width:7px;height:7px;border-radius:50%;background:var(--leaf);box-shadow:0 0 0 4px color-mix(in srgb, var(--leaf) 22%, transparent)}

/* console */
.console{background:var(--ink-2);border:1px solid var(--line);border-radius:18px;box-shadow:0 30px 80px -30px #000;overflow:hidden;min-width:0}
.console-top{display:flex;align-items:center;gap:8px;padding:12px 16px;border-bottom:1px solid var(--line);font-family:var(--f-mono);font-size:12px;color:var(--muted)}
.console-top b{width:10px;height:10px;border-radius:50%;background:var(--ink-3)}
.console-top span{margin-left:auto}
.console-body{padding:18px 18px 22px;font-family:var(--f-mono);font-size:13.5px;line-height:1.5}
.cmd{color:var(--fg);margin-bottom:14px;overflow-wrap:anywhere}
.cmd .p{color:var(--sun)}
.rows{display:grid;gap:6px}
.row{display:grid;grid-template-columns:76px 120px 1fr;gap:10px;align-items:center;padding:9px 10px;border-radius:10px;border:1px solid transparent;transition:background .35s ease, border-color .35s ease}
.row .who{font-size:11px;letter-spacing:.08em;text-transform:uppercase;padding:3px 8px;border-radius:999px;text-align:center}
.row.agent .who{color:var(--leaf);background:color-mix(in srgb, var(--leaf) 12%, transparent)}
.row.person .who{color:var(--sun);background:color-mix(in srgb, var(--sun) 14%, transparent)}
.row .role{color:var(--fg)}
.row .what{color:var(--muted);min-width:0}
.row.on{background:var(--ink-3);border-color:var(--line)}
.done{margin-top:14px;color:var(--leaf)}
.caret{display:inline-block;width:8px;height:15px;background:var(--fg);vertical-align:-2px;margin-left:4px;animation:blink 1.1s steps(1) infinite}
@keyframes blink{50%{opacity:0}}

/* marquee */
.ticker{border-bottom:1px solid var(--line);overflow:hidden;background:var(--ink)}
.ticker-track{display:flex;width:max-content;animation:slide 38s linear infinite}
.ticker ul{display:flex;gap:34px;list-style:none;margin:0;padding:18px 17px;font-family:var(--f-mono);font-size:13px;letter-spacing:.1em;text-transform:uppercase;color:var(--muted);white-space:nowrap}
.ticker li::before{content:"/";color:var(--sun);margin-right:34px}
@keyframes slide{to{transform:translateX(-50%)}}

/* sections */
section{scroll-margin-top:80px}
.sec{padding-block:104px}
.sec-head{display:grid;gap:16px;margin-bottom:48px;max-width:760px}
.sec-head h2{font-size:clamp(32px,4.4vw,54px);font-weight:800}

/* offers */
.offers{display:grid;grid-template-columns:1.25fr 1fr 1fr;gap:18px}
.offer{background:var(--ink-2);border:1px solid var(--line);border-radius:var(--r);padding:30px;display:flex;flex-direction:column;gap:16px;min-width:0}
.offer h3{font-size:26px;font-weight:700}
.offer p{color:var(--muted)}
.offer.lead{background:linear-gradient(160deg, color-mix(in srgb, var(--sun) 16%, var(--ink-2)), var(--ink-2) 60%);border-color:color-mix(in srgb, var(--sun) 40%, var(--line))}
.offer .tag{font-family:var(--f-mono);font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--sun)}
.chips{display:flex;flex-wrap:wrap;gap:8px;margin-top:auto;padding-top:6px;list-style:none;margin-bottom:0;padding-left:0}
.chips li{font-size:13.5px;padding:6px 12px;border-radius:999px;border:1px solid var(--line);color:var(--fg)}
.start{display:grid;grid-template-columns:auto 1fr 1fr;gap:18px;margin-top:18px;align-items:stretch}
.start .label{font-family:var(--f-display);font-weight:700;font-size:20px;align-self:center;padding-right:10px}
.start div.opt{border-top:1px solid var(--line);padding-top:16px}
.start h4{margin:0 0 4px;font:600 17px/1.3 var(--f-body)}
.start p{color:var(--muted);font-size:16px}

/* gtm system */
.gtm{background:var(--ink-2);border-block:1px solid var(--line)}
.loop{display:grid;grid-template-columns:150px repeat(5, minmax(0,1fr));border:1px solid var(--line);border-radius:var(--r);overflow:hidden;background:var(--ink)}
.loop > div{padding:18px 16px;border-right:1px solid var(--line);border-bottom:1px solid var(--line);min-width:0}
.loop > div:nth-child(6n){border-right:0}
.loop > div:nth-last-child(-n+6){border-bottom:0}
.loop .stage{font-family:var(--f-display);font-weight:700;font-size:19px;position:relative;background:var(--ink-2)}
.loop .stage:not(:nth-child(6n))::after{content:"\2192";position:absolute;right:-9px;top:50%;transform:translateY(-50%);font-family:var(--f-mono);font-size:14px;color:var(--sun);background:var(--ink-2);z-index:1;line-height:1}
.loop .lane{font-family:var(--f-mono);font-size:12px;letter-spacing:.1em;text-transform:uppercase;display:flex;align-items:center;gap:8px}
.loop .lane.a{color:var(--leaf)}
.loop .lane.p{color:var(--sun)}
.loop .lane i{width:8px;height:8px;border-radius:50%;background:currentColor}
.loop .cell{font-size:15.5px;color:var(--muted);line-height:1.45}
.loop .cell.p{color:var(--fg)}
.loop .corner{background:var(--ink-2)}
.gtm-note{margin-top:22px;color:var(--muted);font-size:16px;max-width:70ch}

/* cafe wall */
.wall{background:var(--paper);color:var(--paper-ink);position:relative;overflow:hidden}
.wall::before{content:"";position:absolute;inset:0;opacity:.5;background:
  radial-gradient(circle at 20% 30%, rgba(120,90,50,.10) 0 1px, transparent 1.5px) 0 0/18px 18px,
  radial-gradient(circle at 70% 60%, rgba(120,90,50,.08) 0 1px, transparent 1.5px) 0 0/23px 23px}
.wall .wrap{position:relative}
.wall .eyebrow{color:#7A4408}
.wall h2{color:var(--paper-ink);font-family:var(--f-poster);font-weight:400;text-transform:uppercase;letter-spacing:0;font-size:clamp(44px,7.4vw,96px);line-height:.9}
.wall .lede{color:var(--paper-muted)}
.atlas{display:grid;grid-template-columns:minmax(0,1.1fr) minmax(0,1fr);gap:72px;align-items:center;margin-top:52px}
.mapposter{position:relative;margin:0;background:#fff;padding:10px;box-shadow:0 2px 0 rgba(0,0,0,.06), 0 24px 40px -22px rgba(60,40,10,.55);transform:rotate(-.6deg)}
.mapposter::before{content:"";position:absolute;top:-12px;left:50%;width:84px;height:24px;transform:translateX(-50%) rotate(-3deg);background:rgba(255,236,190,.75);box-shadow:0 1px 2px rgba(0,0,0,.08);z-index:2}
.mapfield{position:relative;background:#0A0F1F;aspect-ratio:600/764}
.mapfield > svg{position:absolute;inset:0;width:100%;height:100%}
.mapfoot{display:flex;justify-content:space-between;gap:12px;background:#0A0F1F;color:#A5AECB;font-family:var(--f-mono);font-size:11px;letter-spacing:.12em;text-transform:uppercase;padding:12px 16px;border-top:1px solid #1A2447}
.at-pin{position:absolute;left:var(--x);top:var(--y);width:28px;height:28px;margin:-14px 0 0 -14px;border:0;padding:0;background:transparent;cursor:pointer;border-radius:50%;z-index:1}
.at-pin::before{content:"";position:absolute;inset:9px;border-radius:50%;background:var(--sun);box-shadow:0 0 0 3px rgba(255,181,71,.22);transition:inset .25s ease, background-color .25s ease}
.at-pin:hover::before{inset:7px}
.at-pin[aria-pressed="true"]{z-index:3}
.at-pin[aria-pressed="true"]::before{inset:7px;background:#fff;box-shadow:0 0 0 4px var(--sun), 0 0 0 11px rgba(255,181,71,.22)}
.at-pin:focus-visible{outline:2px solid #fff;outline-offset:0}
.at-label{position:absolute;left:var(--x);top:var(--y);transform:translate(18px,-50%);font-family:var(--f-poster);font-size:clamp(14px,1.9vw,21px);line-height:1;text-transform:uppercase;letter-spacing:.02em;color:#0A0F1F;background:var(--sun);padding:5px 8px 4px;white-space:nowrap;pointer-events:none;z-index:4}
.at-label.left{transform:translate(calc(-100% - 18px),-50%)}
.at-you{position:absolute;left:var(--x);top:var(--y);display:flex;align-items:center;gap:7px;transform:translate(-6px,-6px);font-family:var(--f-mono);font-size:11px;letter-spacing:.1em;text-transform:uppercase;color:#EEF1FA;pointer-events:none;white-space:nowrap;transition:left .5s ease, top .5s ease}
.at-you i{width:12px;height:12px;border-radius:50%;border:2px solid #EEF1FA;background:#0A0F1F;flex:none}
.at-you.left{flex-direction:row-reverse;transform:translate(calc(-100% + 6px),-6px)}


.at-pin[aria-pressed="true"]::after{content:"";position:absolute;inset:4px;border-radius:50%;border:2px solid var(--sun);animation:ping 2.2s ease-out infinite}
@keyframes ping{from{transform:scale(.6);opacity:.9}to{transform:scale(2.2);opacity:0}}
.cityhead{display:grid;gap:10px;padding-top:22px;border-top:1px solid rgba(42,33,24,.18)}
.ch-name{display:flex;align-items:baseline;flex-wrap:wrap;gap:6px 14px;font-family:var(--f-poster);font-size:clamp(40px,4.4vw,58px);line-height:.95;text-transform:uppercase;color:var(--paper-ink)}
.ch-country{font-family:var(--f-body);font-size:16px;font-weight:600;text-transform:none;color:var(--paper-muted)}
.ch-meta{font-family:var(--f-mono);font-size:13px;letter-spacing:.06em;color:var(--paper-muted)}

/* right column */
.atside{display:grid;grid-template-columns:minmax(0,1fr);gap:28px;min-width:0}
.atside > *{min-width:0}
.at-q{font-family:var(--f-mono);font-size:12.5px;letter-spacing:.12em;text-transform:uppercase;color:#7A4408;margin:0 0 12px}
.seg{display:flex;flex-wrap:wrap;gap:6px}
.seg button{font:600 15px/1 var(--f-body);color:var(--paper-ink);background:transparent;border:1px solid rgba(42,33,24,.28);border-radius:999px;padding:0 16px;min-height:44px;cursor:pointer}
.seg button:hover{border-color:var(--paper-ink)}
.seg button[aria-pressed="true"]{background:var(--paper-ink);color:var(--paper);border-color:var(--paper-ink)}
.say{font-family:var(--f-display);font-weight:700;font-size:clamp(22px,2.4vw,30px);line-height:1.25;color:var(--paper-ink);max-width:28ch;text-wrap:pretty}
.say b{font-weight:800;background:linear-gradient(transparent 62%, rgba(255,181,71,.55) 62%)}
.cityline{color:var(--paper-muted);margin-top:12px;max-width:44ch}
.strip{display:grid;gap:8px}
.strip-row{display:grid;grid-template-columns:96px minmax(0,1fr);gap:12px;align-items:center;font-size:13px;color:var(--paper-muted)}
.strip-bar{position:relative;height:14px;border-radius:999px;background:rgba(42,33,24,.10);overflow:hidden}
.strip-bar span{position:absolute;top:0;bottom:0;border-radius:999px}
.strip-bar .you-band{background:var(--paper-ink)}
.strip-bar .team-band{background:#C9821F}
.strip-bar .both-band{background:var(--paper-ink);opacity:.18}
.strip-axis{display:flex;justify-content:space-between;margin-left:108px;font-family:var(--f-mono);font-size:11px;color:var(--paper-muted)}
.shared{font-family:var(--f-display);font-weight:800;font-size:20px;color:var(--paper-ink)}
.citychips{display:flex;flex-wrap:wrap;gap:8px;list-style:none;margin:0;padding:0}
.chip{font:600 14px/1 var(--f-body);color:var(--paper-ink);background:transparent;border:1px solid rgba(42,33,24,.28);border-radius:999px;padding:0 14px;min-height:40px;cursor:pointer;white-space:nowrap}
.chip:hover{border-color:var(--paper-ink)}
.chip[aria-pressed="true"]{background:#C9821F;color:#1B1204;border-color:#C9821F}

/* time and money */
.save-grid{display:grid;grid-template-columns:minmax(0,1.35fr) minmax(0,1fr);gap:20px}
.calc,.timecard{background:var(--ink-2);border:1px solid var(--line);border-radius:var(--r);padding:30px;display:grid;gap:22px;align-content:start;min-width:0}
.calc h3,.timecard h3{font-size:24px;font-weight:700}
.roles{display:flex;flex-wrap:wrap;gap:8px}
.roles button{font:600 14.5px/1 var(--f-body);color:var(--fg);background:transparent;border:1px solid var(--line);border-radius:999px;padding:0 16px;min-height:44px;cursor:pointer}
.roles button:hover{border-color:var(--muted)}
.roles button[aria-pressed="true"]{background:var(--sun);color:var(--sun-ink);border-color:var(--sun)}
.count{display:flex;align-items:center;gap:14px;color:var(--muted);font-size:15px}
.count button{width:44px;height:44px;border-radius:50%;border:1px solid var(--line);background:transparent;color:var(--fg);font:600 20px/1 var(--f-body);cursor:pointer}
.count button:hover{border-color:var(--muted)}
.count output{font:800 22px/1 var(--f-display);color:var(--fg);min-width:2ch;text-align:center;font-variant-numeric:tabular-nums}
.bars{display:grid;gap:16px}
.bar-row{display:grid;gap:8px}
.bar-top{display:flex;justify-content:space-between;gap:12px;font-size:15px;color:var(--muted)}
.bar-top strong{color:var(--fg);font-variant-numeric:tabular-nums;font-weight:600}
.bar{height:12px;border-radius:999px;background:#1A2447;overflow:hidden}
.bar span{display:block;height:100%;border-radius:999px;transition:width .5s cubic-bezier(.2,.7,.2,1)}
.bar .us{background:#5E6A8F}
.bar .la{background:var(--sun)}
.gap{display:flex;align-items:baseline;justify-content:space-between;gap:16px;flex-wrap:wrap;padding-top:18px;border-top:1px solid var(--line)}
.gap span{color:var(--muted);font-size:15px;max-width:26ch}
.gap strong{font:800 clamp(30px,3.6vw,44px)/1 var(--f-display);color:var(--sun);font-variant-numeric:tabular-nums}
.fine{color:var(--muted);font-size:13.5px;line-height:1.55}
.timecard .big{font:800 clamp(44px,5vw,64px)/1 var(--f-display);color:var(--fg);font-variant-numeric:tabular-nums}
.timecard p{color:var(--muted)}
.timecard a{color:var(--fg)}
.opt{display:grid;gap:8px;min-width:0}
.opt.two{grid-template-columns:minmax(0,1fr) auto;gap:16px;align-items:start}
