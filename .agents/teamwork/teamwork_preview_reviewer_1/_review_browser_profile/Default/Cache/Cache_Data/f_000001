        heroRaf = requestAnimationFrame(renderHeroGlow);
      } else {
        heroRaf = null;
      }
    }

    hero.addEventListener('pointermove', function(e) {
      var rect = hero.getBoundingClientRect();
      tarX = e.clientX - rect.left;
